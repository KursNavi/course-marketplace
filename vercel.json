{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kursnavi.ch" }],
      "destination": "https://kursnavi.ch/:path*",
      "permanent": true
    },
    {
      "source": "/bereich/privat_hobby/:path*",
      "destination": "/bereich/privat-hobby/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "functions": {
    "api/thema-redirect.js": {
      "includeFiles": "dist/index.html"
    },
    "api/course-redirect.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/courses/:__topic/:__loc/:__cseg",
      "destination": "/api/course-redirect"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/thema/:segment/:slug",
      "destination": "/api/thema-redirect?segment=:segment&slug=:slug"
    },
    {
      "source": "/bereich/:segment/:slug",
      "destination": "/api/resource-not-found"
    },
    {
      "source": "/bereich/:segment/:slug/:rest*",
      "destination": "/api/resource-not-found"
    },
    {
      "source": "/ratgeber/:category",
      "destination": "/api/resource-not-found"
    },
    {
      "source": "/ratgeber/:category/:cluster",
      "destination": "/api/resource-not-found"
    },
    {
      "source": "/ratgeber/:category/:cluster/:rest*",
      "destination": "/api/resource-not-found"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 12 * * *"
    }
  ]
}
