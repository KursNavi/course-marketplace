{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kursnavi.ch/schemas/theme-world-package-v1.json",
  "title": "KursNavi Themenwelt Handoff Package",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "schema",
    "generated_at",
    "source",
    "theme_world",
    "scenarios",
    "faqs",
    "editorial_sections",
    "specialties",
    "regions",
    "trust_items"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "schema": { "type": "string", "pattern": "^theme-world-import/" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "theme_world": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "key",
        "slug",
        "url_segment",
        "db_segment",
        "title_de",
        "meta_title",
        "meta_description",
        "status"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "slug": { "$ref": "#/$defs/slug" },
        "url_segment": { "enum": ["beruflich", "privat-hobby", "kinder-jugend"] },
        "db_segment": { "enum": ["professionell", "privat", "kinder"] },
        "title_de": { "type": "string", "minLength": 1, "maxLength": 200 },
        "meta_title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "meta_description": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "const": "draft" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "faqs": { "type": "array", "items": { "type": "object" } },
    "editorial_sections": { "type": "array", "items": { "type": "object" } },
    "specialties": { "type": "array", "items": { "type": "object" } },
    "regions": { "type": "array", "items": { "type": "object" } },
    "trust_items": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": true,
      "required": ["slug", "label_de", "content_html", "status", "sources"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "label_de": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content_html": { "type": "string", "minLength": 1 },
        "status": { "const": "draft" },
        "sources": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  }
}
